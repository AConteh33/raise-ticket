{
  "hosting": {
    "public": "html-site",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "server.js"
    ],
    "headers": [
      {
        "source": "/js/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "predeploy": "npm run firebase:config"
  }
}
